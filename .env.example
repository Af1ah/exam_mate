# Deployment secrets and environment-specific endpoints only.
# Copy this file to `.env`, replace every placeholder, and keep it out of Git.

# Docker infrastructure
POSTGRES_PASSWORD="replace-with-a-long-random-database-password"
QUESTIONS_CSV_PATH="/absolute/path/to/questions.csv"

# Application identity and sessions
AUTH_SECRET="replace-with-at-least-32-random-bytes"
QUIZ_PUBLIC_URL="https://exam-mate.example.com"
NEXT_ALLOWED_DEV_ORIGINS="local-dev-tunnel.example.com"

# WAHA connection and webhook verification
WHATSAPP_API_URL="https://wa.example.com"
WHATSAPP_API_KEY="replace-me"
WHATSAPP_INSTANCE_NAME="replace-me"
WAHA_WEBHOOK_SECRET="replace-with-a-long-random-secret"
